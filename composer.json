{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "artesaos/seotools": "^1.4",
        "bgaze/bootstrap-form": "^2.0",
        "consoletvs/charts": "^6.0",
        "cyrildewit/eloquent-viewable": "^7.0",
        "doctrine/dbal": "^3.0",
        "dompdf/dompdf": "^2.0.0",
        "donatello-za/rake-php-plus": "^1.0",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^2.5",
        "kwn/number-to-words": "^1.8",
        "laravel/framework": "^12.0",
        "laravel/socialite": "^5.27",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "league/flysystem": "^3.0",
        "livewire/livewire": "^4.0",
        "mpdf/mpdf": "^8.0",
        "musonza/chat": "^6.15",
        "php-ffmpeg/php-ffmpeg": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "pusher/pusher-php-server": "^7.2",
        "realrashid/sweet-alert": "^7.0",
        "seongbae/comments": "^5.0",
        "spatie/laravel-honeypot": "^4.7",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-searchable": "^1.13",
        "spatie/laravel-sitemap": "^7.4",
        "spatie/laravel-sluggable": "^3.8",
        "spatie/pdf-to-image": "^3.0",
        "stevenmaguire/oauth2-microsoft": "^2.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "driftingly/rector-laravel": "^2.3",
        "fakerphp/faker": "^1.23",
        "imanghafoori/laravel-microscope": "^1.0",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.4",
        "spatie/laravel-ignition": "^2.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true,
            "treeware/plant": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/Helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi",
            "@php artisan cache:clear",
            "@php artisan view:clear",
            "@php artisan route:clear",
            "@php artisan route:cache",
            "@php artisan config:clear",
            "@php artisan config:cache",
            "@php artisan migrate",
            "@php artisan ide-helper:eloquent",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --write",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
